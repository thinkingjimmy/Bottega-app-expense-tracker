        "note": "示例：换季衣物"
      }
    },
    {
      "id": "sample-4",
      "values": {
        "date": "2026-03-04",
        "amount": 3200,
        "category": "housing",
        "note": "示例：三月房租"
      }
    },
    {
      "id": "sample-5",
      "values": {
        "date": "2026-03-05",
        "amount": 48,
        "category": "entertainment",
        "note": "示例：电影票两张"
      }
    },
    {
      "id": "sample-6",
